APP_NAME="Learn Renox"
APP_ENV=local
APP_DEBUG=true
# Canonical links, the sitemap and the JSON-LD use it.
APP_URL=http://127.0.0.1:3000
APP_PORT=3000
# The site keeps no data yet; the database only holds Renox's own tables.
DATABASE_URL=sqlite://storage/app.db
QUEUE_WORKERS=0
SCHEDULER=false
# Where the chapters' videos are served from: a path on this site's own origin
# (the default CSP allows <video> from it). The default is Renox's public disk,
# STORAGE_PATH/app/public/media/, which Caddy can serve straight from disk.
# LEARN_MEDIA_URL=/storage/media
