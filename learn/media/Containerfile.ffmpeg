# The image encode.sh runs ffmpeg in, built as renox-learn-ffmpeg:1. Debian
# bookworm's ffmpeg is the 5.1 series (libvpx-vp9, libx264 and libwebp in).
FROM docker.io/library/debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
