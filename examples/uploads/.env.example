APP_NAME="Renox Uploads"
APP_ENV=local
APP_PORT=3000
# Generate one with `rnx key:generate`. Needed here: private download links are signed
# with it, so links handed out before a restart stop working without one.
APP_KEY=
DATABASE_URL=sqlite://storage/app.db
# `log` writes mail to the server log; with APP_DEBUG on it's also listed at
# /_renox/mail. Use `smtp` (MAIL_HOST, MAIL_PORT, …) in production.
MAIL_MAILER=log

# Largest request body in megabytes (photos are also checked per file).
UPLOAD_MAX_SIZE=10
# `local` (storage/app) or `s3` (needs renox's `s3` feature).
STORAGE_DISK=local
