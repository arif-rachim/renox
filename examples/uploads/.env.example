APP_NAME="Renox Uploads"
APP_ENV=local
APP_PORT=3000
# Generate one with `rnx key:generate`. Needed here: private download links are signed
# with it, so links handed out before a restart stop working without one.
APP_KEY=
DATABASE_URL=sqlite://storage/app.db
# `log` writes mail to the server log; with APP_DEBUG on it's also listed at
# /_renox/mail. Use `smtp` (MAIL_HOST, MAIL_PORT, …) in production.
MAIL_MAILER=log

# Largest request body in megabytes (photos are also checked per file).
UPLOAD_MAX_SIZE=10
# `local` (storage/app) or `s3`: run with `cargo run --features s3`.
STORAGE_DISK=local
# On S3 (AWS, Cloudflare R2, DigitalOcean Spaces, MinIO, SeaweedFS…). Photos are public:
# their links start with STORAGE_URL (the bucket's public address or a CDN in front of it).
# Invoices stay private: their links are presigned and expire after five minutes.
# S3_BUCKET=shop-uploads
# S3_REGION=ap-southeast-1
# S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# STORAGE_URL=https://cdn.example.com
