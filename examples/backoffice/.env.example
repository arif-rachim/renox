APP_NAME="Back office"
APP_ENV=local
APP_PORT=3000
# Generate one with `rnx key:generate`. Required in production (APP_ENV=production).
APP_KEY=
DATABASE_URL=sqlite://storage/app.db
# `log` writes mail (staff verification links) to the server log; with
# APP_DEBUG on it's also listed at /_renox/mail.
MAIL_MAILER=log
# Prices and invoices are in US dollars, stored in cents. Midtrans and Xendit
# charge rupiah only: a live account there takes the amounts as IDR.
APP_CURRENCY=USD
# Invoices are dated in this zone.
APP_TIMEZONE=Asia/Jakarta

# Online payments: choose the gateway on /settings, put its keys here.
# Midtrans: the server key (sandbox keys start with SB-Mid-server-).
MIDTRANS_SERVER_KEY=
# MIDTRANS_URL=https://app.midtrans.com     # production; the sandbox by default
# Xendit: the secret API key, and the callback verification token.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# XENDIT_URL=https://api.xendit.co

# Invoice exports (a disk of their own): storage/exports by default. On S3:
# EXPORTS_DISK=s3
# EXPORTS_BUCKET=backoffice-exports
