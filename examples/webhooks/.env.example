APP_NAME="Renox Webhooks"
APP_ENV=local
APP_PORT=3000
# Generate one with `rnx key:generate`. Without it, sessions end on restart.
APP_KEY=
DATABASE_URL=sqlite://storage/app.db
# `log` writes mail to the server log; with APP_DEBUG on it's also listed at
# /_renox/mail. Use `smtp` (MAIL_HOST, MAIL_PORT, …) in production.
MAIL_MAILER=log

# The secrets from each provider's dashboard; a call that can't be verified
# against them is refused (401).
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
XENDIT_CALLBACK_TOKEN=xnd-callback-token
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
