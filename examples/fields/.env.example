APP_NAME="Renox Fields"
APP_ENV=local
APP_PORT=3000
# Generate one with `rnx key:generate`. Without it, sessions end on restart.
APP_KEY=
DATABASE_URL=sqlite://storage/app.db
# `log` writes mail to the server log; with APP_DEBUG on it's also listed at
# /_renox/mail. Use `smtp` (MAIL_HOST, MAIL_PORT, …) in production.
MAIL_MAILER=log

# Or PostgreSQL (renox's `postgres` feature, on in this example):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/fields
# The currency of the `money` filter.
APP_CURRENCY=IDR
