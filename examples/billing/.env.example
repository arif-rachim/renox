APP_NAME=Inkwell
APP_ENV=local
APP_PORT=3000
# Generate one with `rnx key:generate`. Without it, sessions end on restart.
APP_KEY=
# The gateways send their webhooks here: a public URL (a tunnel while developing).
APP_URL=http://127.0.0.1:3000
DATABASE_URL=sqlite://storage/app.db
MAIL_MAILER=log

# Stripe (test mode keys from the dashboard). Without STRIPE_SECRET, Stripe is off.
# The webhook endpoint is APP_URL/billing/webhooks/stripe.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Each plan's recurring Price in Stripe.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# Xendit (the "Pro (IDR)" plan). Without XENDIT_SECRET_KEY, Xendit is off.
# The webhook URL for the Recurring events is APP_URL/billing/webhooks/xendit.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
