# /etc/systemd/system/shop.service
[Unit]
Description=Shop
After=network.target
# With deploy/shop.socket enabled, systemd passes the listening socket and
# restarts don't refuse connections (see deploy/README.md).

[Service]
User=shop
WorkingDirectory=/opt/shop
EnvironmentFile=/opt/shop/.env
ExecStartPre=/opt/shop/shop migrate
ExecStart=/opt/shop/shop
Restart=on-failure
# Renox finishes running jobs on SIGTERM (up to 30 s).
KillSignal=SIGTERM
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
