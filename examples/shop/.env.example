APP_NAME="Renox Shop"
APP_ENV=local
APP_PORT=3000
# Generate one with `rnx key:generate`. Required in production (APP_ENV=production).
APP_KEY=
DATABASE_URL=sqlite://storage/app.db
# `log` writes mail to the server log; with APP_DEBUG on it's also listed at
# /_renox/mail. Use `smtp` (MAIL_HOST, MAIL_PORT, …) in production.
MAIL_MAILER=log

# The shop speaks both; visitors switch at the bottom of the page.
APP_LOCALE=id
APP_CURRENCY=IDR
APP_TIMEZONE=Asia/Jakarta
# `cookie` (the default) or `database` (sessions in the `sessions` table).
SESSION_DRIVER=cookie
