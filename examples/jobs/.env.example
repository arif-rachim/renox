APP_NAME="Renox Jobs"
APP_ENV=local
APP_PORT=3000
# Generate one with `rnx key:generate`. Needed here: queued payloads are encrypted with it,
# so jobs queued before a restart without one can't be read after.
APP_KEY=
DATABASE_URL=sqlite://storage/app.db
# `log` writes mail to the server log; with APP_DEBUG on it's also listed at
# /_renox/mail. Use `smtp` (MAIL_HOST, MAIL_PORT, …) in production.
MAIL_MAILER=log
# Sales reports have a mailer of their own (`App::mailer("reports", …)`):
# REPORTS_MAILER=smtp and REPORTS_HOST, REPORTS_USERNAME, … Unset, it is MAIL_MAILER.
# When the main mailer fails, try another one (an App::mailer name):
# MAIL_FAILOVER=reports

# Scheduled reports run on Jakarta time.
APP_TIMEZONE=Asia/Jakarta
# Who gets the warehouse's "ship it" mail, and the alert when a report fails.
WAREHOUSE_EMAIL=warehouse@example.com
# Copied on the warehouse mail (cc), and sent each statement unseen (bcc).
MANAGER_EMAIL=manager@example.com
ACCOUNTS_EMAIL=accounts@example.com
# Where replies to receipts go.
SUPPORT_EMAIL=support@example.com
ALERT_EMAIL=admin@example.com
# The payment gateway; without a URL the app's own sandbox route answers.
# PAYMENT_GATEWAY_URL=https://api.gateway.example/charges
PAYMENT_GATEWAY_KEY=sk_test_example
# Errors a person should see also go to this chat webhook (Slack, Discord…).
# ERROR_WEBHOOK_URL=https://hooks.slack.com/services/…
