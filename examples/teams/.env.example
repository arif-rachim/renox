APP_NAME="Renox Teams"
APP_ENV=local
APP_PORT=3000
# Generate one with `rnx key:generate`. Needed here: team secrets (`Encrypted<String>`) are
# sealed with it and can't be read with another key.
APP_KEY=
DATABASE_URL=sqlite://storage/app.db
# `log` writes mail to the server log; with APP_DEBUG on it's also listed at
# /_renox/mail. Use `smtp` (MAIL_HOST, MAIL_PORT, …) in production.
MAIL_MAILER=log

# Team pages live on {slug}.TEAM_DOMAIN (acme.localhost:3000 in development).
TEAM_DOMAIN=localhost
# Comma-separated emails of super-admins (they pass every gate).
SUPER_ADMINS=alice@example.com
