APP_NAME="Renox Tasks"
APP_ENV=local
APP_PORT=3000
# Generate one with `rnx key:generate`. Without it, sessions end on restart.
APP_KEY=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tasks
# `log` writes mail to the server log; with APP_DEBUG on it's also listed at
# /_renox/mail. Use `smtp` (MAIL_HOST, MAIL_PORT, …) in production.
MAIL_MAILER=log

# Or SQLite, with the same code:
# DATABASE_URL=sqlite://storage/app.db
# Tests use a fresh schema in this database:
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tasks_test
