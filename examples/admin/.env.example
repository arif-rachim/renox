APP_NAME="Corner Shop"
APP_ENV=local
APP_PORT=3000
# Generate one with `rnx key:generate`. Without it, sessions end on restart.
APP_KEY=
DATABASE_URL=sqlite://storage/app.db
MAIL_MAILER=log
# Prices are in rupiah; the panel's money fields and columns use it.
APP_CURRENCY=IDR
APP_TIMEZONE=Asia/Jakarta
