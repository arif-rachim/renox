APP_NAME="Corner Shop"
APP_ENV=local
APP_PORT=3000
# Generate one with `rnx key:generate`. Without it, sessions end on restart.
APP_KEY=
DATABASE_URL=sqlite://storage/app.db
MAIL_MAILER=log
# Prices are in US dollars, stored in cents; the panel's money fields and
# columns use it.
APP_CURRENCY=USD
APP_TIMEZONE=Asia/Jakarta
