APP_NAME="{{title}}"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:3000
APP_KEY={{app_key}}
APP_PORT=3000
# Language of built-in messages: en or id.
APP_LOCALE=en

DATABASE_URL=sqlite://storage/app.db

# `log` writes emails (password reset, verification links) to the server log.
MAIL_MAILER=log

# Background jobs and scheduled tasks run inside `serve`.
QUEUE_WORKERS=2
SCHEDULER=true
# UTC offset for scheduled times, e.g. +07:00 for WIB.
APP_TIMEZONE=UTC
